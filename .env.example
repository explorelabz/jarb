# Safe default: Paper injects fake exchanges at the adapter boundary.
TRADING_MODE=paper
PORT=8787

# Required for every control-plane API except /api/health. Give each human a
# unique random token of at least 32 characters; never reuse one token for two actors.
JARB_OPERATOR_TOKENS=operator-a=replace-with-a-random-token-at-least-32-chars,operator-b=replace-with-another-random-token-32-chars

# Live mode connects real APIs but always starts DISARMED. Never commit real credentials.
BITTRADE_ACCESS_KEY=
BITTRADE_SECRET_KEY=
BITTRADE_ACCOUNT_ID=
GMO_API_KEY=
GMO_SECRET_KEY=

SYMBOL=BTC_JPY
SPREAD_BPS=25
BITTRADE_MAKER_FEE_BPS=0
# Optional per-asset GMO taker overrides, in bps. Omitted assets use the built-in public schedule.
GMO_TAKER_FEE_BPS_OVERRIDES=BTC=5,ETH=5,XRP=5,DAI=5
GMO_MAKER_FEE_BPS_OVERRIDES=BTC=-1,ETH=-1,XRP=-1,DAI=-1
EXPECTED_PASSIVE_FILL_RATIO=0.8
GMO_POST_ONLY_TIMEOUT_MS=800
MAX_HEDGE_SLIPPAGE_BPS=3
EXPECTED_SLIPPAGE_BPS=3
BITTRADE_QUEUE_BUDGET=0.05
MAX_QUOTE_SIZE=0.05
DELTA_LIMIT=0.005
MAX_HEDGE_LATENCY_MS=2500
# Must remain longer than the 2s REST watchdog cadence to avoid quote flapping.
STALE_MARKET_MS=3000
QUOTE_REFRESH_MS=1000

# Runtime-adjustable risk limits (also exposed by GET/PATCH /api/risk/limits).
MAX_SINGLE_ORDER_JPY=250000
MAX_DAILY_VOLUME_JPY=5000000
MAX_DAILY_LOSS_JPY=100000
MAX_ABS_DELTA=0.005
MAX_HEDGE_FAILURES=3
MAX_HEDGE_P95_MS=2500
ARM_TTL_SEC=3600
ARM_CONFIRMATION_PHRASE="change-this-before-live"
# false: Arm、API Key 和风控限额等敏感操作均由当前操作员单人完成。
# true: 上述操作均要求两位不同的具名操作员确认。
REQUIRE_DUAL_ARM_APPROVAL=false
KILL_SENTINEL=data/KILL
