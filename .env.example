# Safe default: the service runs entirely in simulation.
TRADING_MODE=simulation
PORT=8787

# Live trading needs BOTH flags. Never commit real credentials.
LIVE_TRADING=false
ARM_LIVE_TRADING=
BITTRADE_ACCESS_KEY=
BITTRADE_SECRET_KEY=
BITTRADE_ACCOUNT_ID=
GMO_API_KEY=
GMO_SECRET_KEY=

SYMBOL=BTC_JPY
SPREAD_BPS=10
GMO_FEE_BPS=2
EXPECTED_SLIPPAGE_BPS=1.5
MAX_QUOTE_SIZE=0.05
DELTA_LIMIT=0.005
MAX_HEDGE_LATENCY_MS=1000
STALE_MARKET_MS=5000
QUOTE_REFRESH_MS=1000
